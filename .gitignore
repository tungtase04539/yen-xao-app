# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ bản mẫu: chỉ liệt kê TÊN biến, không có giá trị thật
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Script thử nghiệm dùng một lần — chứa khoá service_role và thao tác ghi thẳng
# lên database, TUYỆT ĐỐI không được commit (repo này đang public).
/scratch/

# Metadata cục bộ của Supabase CLI (chứa project ref, pooler URL)
/supabase/.temp/

# Cấu hình Claude Code cục bộ của từng máy
.claude/settings.local.json
