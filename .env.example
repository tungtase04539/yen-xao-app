# Sao chép file này thành .env.local rồi điền giá trị thật.
# TUYỆT ĐỐI không commit .env.local — file đó chứa khoá thật.

# === Bắt buộc để chạy app (next dev / next build) ===
# Supabase → Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tuỳ chọn: domain public dùng cho canonical URL và ảnh Open Graph.
# Bỏ trống sẽ mặc định là https://qiqiyensao.com (xem src/lib/og.ts).
NEXT_PUBLIC_SITE_URL=

# Tuỳ chọn: tài khoản Cloudinary nhận ảnh upload từ panel admin.
# Bỏ trống sẽ dùng giá trị mặc định trong src/lib/cloudinary.ts.
# Đây là unsigned upload nên hai giá trị này lộ ra bundle client — siết quyền ở
# Cloudinary console chứ đừng coi chúng là bí mật.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# === Chỉ dùng cho các script trong scripts/, KHÔNG cần để chạy app ===
# Các script chạy bằng: node --env-file=.env.local scripts/<script>.mjs

# scripts/generate-blog-thumbnails.mjs — sinh thumbnail blog bằng Imagen rồi upload Storage.
# SUPABASE_SERVICE_ROLE_KEY bypass toàn bộ RLS: chỉ để trên máy cá nhân, không đưa lên client.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# scripts/test_openai.mjs
OPENAI_API_KEY=

# scripts/migrate_supabase.mjs — job một lần, DROP toàn bộ bảng ở project đích.
# SUPABASE_ACCESS_TOKEN là Personal Access Token (Account → Access Tokens),
# chạy được SQL tuỳ ý trên MỌI project trong tài khoản.
SUPABASE_ACCESS_TOKEN=
MIGRATE_SOURCE_REF=
MIGRATE_TARGET_REF=
MIGRATE_SOURCE_SERVICE_KEY=
MIGRATE_TARGET_SERVICE_KEY=
# Chốt an toàn: phải đúng bằng MIGRATE_TARGET_REF thì script mới chịu xoá.
# Để trống ⇒ script chạy dry-run. Đừng điền sẵn ở đây.
MIGRATE_CONFIRM_DROP_REF=
